#!/bin/sh
# SDDM session entry for Hyprland (illogical-impulse). Everything lives in ~/.local/opt/hyprland; nothing is installed system-wide.
# No LD_LIBRARY_PATH / QML_IMPORT_PATH: binaries carry RPATH, so apps launched from here (e.g. Isaac Sim) see the normal system libs.
P="$HOME/.local/opt/hyprland"
export PATH="$P/session-bin:$PATH"
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland
export XDG_DATA_DIRS="$P/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# GPU, decided at login from /sys/class/drm (PCI GPUs only). The display GPU is the one with the built-in panel connected
# (eDP/LVDS/DSI), else one with any output connected (boot_vga first), else the boot_vga one.
#   NVIDIA drives the display (MUX dGPU mode, desktop): NVIDIA GL/GBM/VA-API vars (driver 595, nvidia_drm modeset=1).
#   Other GPU drives it (Optimus, iGPU primary): no NVIDIA vars, so apps stay on the iGPU (offload with prime-run).
#   Several GPUs: AQ_DRM_DEVICES lists the display GPU first (unless already set). One GPU: left unset.
# This laptop (MUX, dGPU-only): card1 = NVIDIA, eDP-1 connected, no other GPU -> NVIDIA vars, AQ_DRM_DEVICES unset.
# What was picked goes to stderr: ~/.local/share/sddm/wayland-session.log
D=/sys/class/drm; cards= nv= gpu=
conn(){ # conn CARD PATTERN... -> true if CARD has a connected output whose name matches one of the patterns
  k=$1; shift
  for p; do for s in "$D/$k"-$p/status; do [ "$(cat "$s" 2>/dev/null)" = connected ] && return 0; done; done; return 1
}
for c in "$D"/card[0-9]*; do
  case ${c##*/} in *-*) continue ;; esac            # connectors (card1-eDP-1)
  [ -r "$c/device/vendor" ] || continue             # simpledrm / non-PCI
  c=${c##*/}
  if [ "$(cat "$D/$c/device/boot_vga" 2>/dev/null)" = 1 ]; then cards="$c $cards"; else cards="$cards $c"; fi
  [ "$(cat "$D/$c/device/vendor")" = 0x10de ] && nv="$nv $c"
done
for c in $cards; do conn "$c" 'eDP-*' 'LVDS-*' 'DSI-*' && { gpu=$c; break; }; done
[ -n "$gpu" ] || for c in $cards; do conn "$c" '*' && { gpu=$c; break; }; done
[ -n "$gpu" ] || for c in $cards; do gpu=$c; break; done
case " $nv " in *" ${gpu:-none} "*)
  export LIBVA_DRIVER_NAME=nvidia __GLX_VENDOR_LIBRARY_NAME=nvidia GBM_BACKEND=nvidia-drm NVD_BACKEND=direct ;;
esac
if [ -z "${AQ_DRM_DEVICES:-}" ] && [ "$(echo $cards | wc -w)" -gt 1 ]; then
  AQ_DRM_DEVICES=/dev/dri/$gpu
  for c in $cards; do [ "$c" = "$gpu" ] || AQ_DRM_DEVICES="$AQ_DRM_DEVICES:/dev/dri/$c"; done
  export AQ_DRM_DEVICES
fi
# VM mode: with ~/.config/hyprland-ii/gpu-passthrough present, Hyprland opens only the display GPU, so the other GPU (the 4070) has no
# open handles and can be handed to vfio-pci for the win11 VM. Outputs wired to that GPU (HDMI) do not work on the host in this mode.
if [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/hyprland-ii/gpu-passthrough" ] && [ -n "$gpu" ]; then
  AQ_DRM_DEVICES=/dev/dri/$gpu; export AQ_DRM_DEVICES
  # glvnd/Vulkan would still load the NVIDIA libraries and open /dev/nvidia* (Hyprland, Xwayland, Electron), which blocks unbinding.
  export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
  export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/intel_icd.json
fi
echo "hyprland-ii-session: gpus=[$(echo $cards)] nvidia=[$(echo $nv)] display=${gpu:-none} GBM_BACKEND=${GBM_BACKEND:-} AQ_DRM_DEVICES=${AQ_DRM_DEVICES:-}" >&2
export ELECTRON_OZONE_PLATFORM_HINT=auto
export QS_ICON_THEME=breeze-dark
exec "$P/bin/start-hyprland" --path "$P/bin/Hyprland" --no-nixgl
