# Settings shared by all phases. Sourced by lib/common.sh.

# Everything Hyprland-related is installed here, never into /usr. Delete it to undo the build.
PREFIX="${PREFIX:-$HOME/.local/opt/hyprland}"
# Source checkouts, build trees, downloads and logs.
SRC="${SRC:-$HOME/src/hypr}"
# Where backups (snap data, config tarballs) go.
BACKUP_DIR="${BACKUP_DIR:-$HOME/backups}"

# Qt from Qt's official binaries (aqtinstall). Must be >= 6.10: the shell imports Qt.labs.synchronizer.
QT_VER=6.10.3
QT="$PREFIX/qt/$QT_VER/gcc_64"

# end-4/dots-hyprland commit the dots are copied from (tested 2026-10-02).
DOTS_REPO=https://github.com/end-4/dots-hyprland
DOTS_COMMIT=547836f1b01a45445cfbbcd92b206d1b5ceee4d9

# Things that must be in the same state after every phase (e.g. a device-management agent). Every run (setup.sh or a
# phase script on its own) fingerprints them first and fails if they differ afterwards. Space-separated; empty = skip.
#   units:    active/enabled state + hash of the full unit definition (`systemctl cat`, incl. drop-ins)
#   packages: installed version + dpkg status
#   paths:    existence, owner, mode, type (not contents: Fleet's orbit updates its own binaries)
PROTECTED_UNITS="${PROTECTED_UNITS-orbit.service sunrise-firstboot.service}"
PROTECTED_PACKAGES="${PROTECTED_PACKAGES-fleet-osquery}"
PROTECTED_PATHS="${PROTECTED_PATHS-/opt/orbit /usr/local/sbin/sunrise-firstboot.sh /var/lib/sunrise-firstboot.done}"

# Minimum free space on / before building (GB).
MIN_FREE_GB=15
