{
    "apps": {
        "changePassword": "@HOME@/.local/kitty.app/bin/kitty --hold fish -i -c 'passwd'",
        "terminal": "@HOME@/.local/kitty.app/bin/kitty -1",
        "update": "@HOME@/.local/kitty.app/bin/kitty --hold @REPO@/maintenance/update.sh"
    },
    "dock": {
        "pinnedApps": [
            "org.kde.dolphin",
            "kitty"
        ]
    },
    "launcher": {
        "pinnedApps": [
            "org.kde.dolphin",
            "kitty",
            "code"
        ]
    }
}
