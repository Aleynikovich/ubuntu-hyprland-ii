#!/usr/bin/env python3
"""Fastfetch with a Sunrise Robotics style logo instead of the distro logo, as ASCII art: a coral sun shaded with a density ramp rising
over a horizon, with lines below it that spread out toward the viewer and drift forward while the sun fades into them.
~0.5s, any keypress skips to the finished picture. Plain fastfetch output when not on a tty."""
import datetime, math, os, select, subprocess, sys, termios, time, tty

FRAMES = 16            # ~0.5s
W, H = 46, 16          # logo size in characters (a cell is ~1:2, so rows count double below)
HZ = 9                 # horizon row
LSPAN = 6                            # ground lines reach at most this many rows below the horizon
RAMP = " .:-=+*#%@"

# Time of day (KITTY_FETCH_HOUR=14.5 to test): the sun's resting height follows the clock, low and coral at dawn/dusk,
# high and amber at noon; from 20:00 to 06:00 it is a smaller pale moon with dimmer ground lines.
now = datetime.datetime.now()
hour = float(os.environ.get("KITTY_FETCH_HOUR", now.hour + now.minute / 60))
if 6 <= hour < 20:
    alt = math.sin(math.pi * (hour - 6) / 14)                                # 0 at 06:00/20:00, 1 at 13:00
    SUN = (W / 2, 10 - 3.5 * alt, 11.5)                                      # centre column, centre row, radius in columns
    BODY = tuple(int(c + (a - c) * alt) for c, a in zip((233, 108, 82), (247, 178, 98)))
    LINE = (150, 154, 140)
else:
    SUN = (W / 2, 6.0, 7.5)
    BODY = (190, 200, 235)
    LINE = (105, 110, 135)

info = subprocess.run(["fastfetch", "--logo", "none", "--pipe", "false", *sys.argv[1:]],
                      capture_output=True, text=True).stdout.rstrip("\n").split("\n")

if not (sys.stdout.isatty() and sys.stdin.isatty()):
    print("\n".join(info)); sys.exit()

def ease(t):
    return 1 - (1 - t) ** 3

def render(p):
    cx, cy, r = SUN
    y_end = cy + r / 2
    cy += (1 - ease(min(1, p / 0.75))) * (r / 2 + 3)             # the sun climbs up from below the horizon
    drift = p % 1.0 if p < 1 else 0.0                            # ground lines advance one slot and land back where they started
    lines = {HZ: "="}
    for k in range(6):
        d = k + drift
        off = d * (d + 1) / 2                                    # 0, 1, 3, 6: each gap one row wider than the last
        if off <= LSPAN + 0.5:
            lines.setdefault(HZ + int(round(off)), "-")
    sun_c, line_c = "\x1b[38;2;%d;%d;%dm" % BODY, "\x1b[38;2;%d;%d;%dm" % LINE
    rows = []
    for y in range(H):
        row, cur = [], None
        for x in range(W):
            dist = math.hypot(x + 0.5 - cx, (y + 0.5 - cy) * 2)          # rows are twice as tall as columns are wide
            cov = max(0.0, min(1.0, r - dist + 0.5))
            fade = 1.0 if y < HZ else max(0.0, 1 - (y - HZ) / min(3.0, max(0.5, y_end - HZ)))   # below the horizon the sun fades out
            tv = max(0.0, min(1.0, (y + 0.5 - (cy - r / 2)) / r))              # 0 at the top of the sun, 1 at the bottom
            idx = min(len(RAMP) - 1, int(cov * fade * (1 - 0.55 * tv) * len(RAMP)))   # denser at the top, lighter toward the horizon
            ch, col = RAMP[idx], sun_c
            if y >= HZ and idx < 3:
                ch = " "                                                    # no faint dots left over below the horizon
            if y in lines and y >= HZ and idx < 6:                             # ground lines sit over the faded part of the sun
                ch, col = lines[y], line_c
            if ch == " ":
                row.append(" "); continue
            if col != cur:
                row.append(col); cur = col
            row.append(ch)
        rows.append("".join(row) + "\x1b[0m")
    return rows

def draw(logo):
    n = max(len(logo), len(info))
    top = (len(logo) - len(info)) // 2 if len(logo) > len(info) else 0    # centre the text beside the logo
    rows = [(logo[i] if i < len(logo) else " " * W) + "  " + (info[i - top] if 0 <= i - top < len(info) else "") + "\x1b[K"
            for i in range(n)]
    return "\n".join(rows), n

fd = sys.stdin.fileno()
old = termios.tcgetattr(fd)
sys.stdout.write("\x1b[?25l")
try:
    tty.setcbreak(fd)
    for i in range(FRAMES + 1):
        text, n = draw(render(i / FRAMES))
        if i: sys.stdout.write(f"\x1b[{n - 1}A\r")
        sys.stdout.write(text); sys.stdout.flush()
        if i < FRAMES and select.select([fd], [], [], 0.03)[0]:   # keypress: jump to the finished picture, leave the key for the prompt
            sys.stdout.write(f"\x1b[{n - 1}A\r" + draw(render(1))[0]); break
    sys.stdout.write("\n")
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, old)
    sys.stdout.write("\x1b[?25h")
